# Copy to `secrets.toml` (same folder) for local runs, or paste the contents into
# Streamlit Community Cloud under  Manage app -> Settings -> Secrets.
#
# `secrets.toml` itself is gitignored and must never be committed.
#
# Only needed to point the dashboard at a DIFFERENT sheet than the default baked into
# data_loader.py. The URL is not a credential — what actually controls access is the
# sheet's own sharing setting, which must be "Anyone with the link -> Viewer".

[data]
sheet_url = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit"
